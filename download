const PORT = Number(process.env.PORT || 10000);
const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, "..", "data");
const DB_FILE = path.join(DATA_DIR, "database.json");
const DEFAULT_COLOR = process.env.DEFAULT_COLOR || "#5865F2";
