if(process.env.DISCORD_TOKEN&&process.env.CLIENT_ID)client.login(process.env.DISCORD_TOKEN).catch(e=>console.error("Discord login failed",e));else console.error("DISCORD_TOKEN or CLIENT_ID is missing.");
