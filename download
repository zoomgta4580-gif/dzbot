async function openTicket(i){const c=cfg(i.guild.id);const existing=c.tickets.find(t=>t.userId===i.user.id&&!t.closedAt);if(existing){const ch=i.guild.channels.cache.get(existing.channelId);if(ch)return i.reply({content:`❌ You already have an open ticket: <#${ch.id}>`,ephemeral:true});}
 const me=i.guild.members.me;const overwrites=[{id:i.guild.roles.everyone.id,deny:[PermissionsBitField.Flags.ViewChannel]},{id:i.user.id,allow:[PermissionsBitField.Flags.ViewChannel,PermissionsBitField.Flags.SendMessages,PermissionsBitField.Flags.ReadMessageHistory,PermissionsBitField.Flags.AttachFiles]},{id:me.id,allow:[PermissionsBitField.Flags.ViewChannel,PermissionsBitField.Flags.SendMessages,PermissionsBitField.Flags.ReadMessageHistory,PermissionsBitField.Flags.ManageChannels]}];
 if(c.ticketSupportRoleId)overwrites.push({id:c.ticketSupportRoleId,allow:[PermissionsBitField.Flags.ViewChannel,PermissionsBitField.Flags.SendMessages,PermissionsBitField.Flags.ReadMessageHistory]});
 const name=`support-${i.user.username.replace(/[^a-z0-9]/gi,"-").slice(0,16)}-${Date.now().toString().slice(-4)}`;
 const ch=await i.guild.channels.create({name,type:ChannelType.GuildText,parent:c.ticketCategoryId||undefined,permissionOverwrites:overwrites,topic:`Support ticket for ${i.user.tag}`});
 const close=new ActionRowBuilder().addComponents(new ButtonBuilder().setCustomId("ticket_close").setLabel("CLOSE TICKET").setEmoji("🔒").setStyle(ButtonStyle.Danger));
 await ch.send({content:`<@${i.user.id}>${c.ticketSupportRoleId?` <@&${c.ticketSupportRoleId}>`:""}`,embeds:[baseEmbed(c,"🎫 SUPPORT TICKET CREATED","**Welcome to support.**\n\nPlease describe your issue in as much detail as possible. Include an order number or relevant screenshots if needed.\n\nA staff member will assist you as soon as possible.")],components:[close]});
 c.tickets.push({id:uid(),channelId:ch.id,userId:i.user.id,userName:i.user.tag,createdAt:Date.now()});log(i.guild.id,"Ticket opened",i.user,{channelId:ch.id});return i.reply({content:`✅ Your support ticket has been created: <#${ch.id}>`,ephemeral:true});}
async function closeTicket(i){const c=cfg(i.guild.id);const t=c.tickets.find(x=>x.channelId===i.channelId&&!x.closedAt);if(!t)return i.reply({content:"❌ This channel is not an active support ticket.",ephemeral:true});const allowed=t.userId===i.user.id||isAdmin(i)||(c.ticketSupportRoleId&&i.member.roles.cache.has(c.ticketSupportRoleId));if(!allowed)return i.reply({content:"❌ You do not have permission to close this ticket.",ephemeral:true});t.closedAt=Date.now();log(i.guild.id,"Ticket closed",i.user,{channelId:i.channelId});await i.reply("🔒 This ticket will be closed in **5 seconds**.");setTimeout(()=>i.channel.delete("Support ticket closed").catch(()=>{}),5000);}

client.on("interactionCreate",async i=>{try{if(!i.guild)return;if(i.isButton()){if(i.customId==="verify"){const c=cfg(i.guild.id);if(!c.verifyRoleId)return i.reply({content:"❌ Verification is not configured yet.",ephemeral:true});const m=await i.guild.members.fetch(i.user.id);const r=i.guild.roles.cache.get(c.verifyRoleId);if(!r)return i.reply({content:"❌ The configured verification role no longer exists.",ephemeral:true});if(r.position>=i.guild.members.me.roles.highest.position)return i.reply({content:"❌ The verification role must be below the bot's highest role.",ephemeral:true});if(m.roles.cache.has(r.id))return i.reply({content:"✅ You are already verified.",ephemeral:true});await m.roles.add(r);log(i.guild.id,"Member verified",i.user);return i.reply({content:"🎉 Verification successful! You now have access to the server.",ephemeral:true});}if(i.customId==="ticket_open")return openTicket(i);if(i.customId==="ticket_close")return closeTicket(i);}
 if(!i.isChatInputCommand())return;if(["setup","verify","shop","payments","offer","ticket-panel"].includes(i.commandName)&&!isAdmin(i))return i.reply({content:"❌ This command is restricted to server administrators.",ephemeral:true});const c=cfg(i.guild.id);
 if(i.commandName==="ping")return i.reply({embeds:[baseEmbed(c,"🏓 PONG!",`The bot is online and responding.\n\n**Latency:** ${client.ws.ping} ms\n**Uptime:** ${Math.floor(process.uptime()/60)} minutes`)],ephemeral:true});
 if(i.commandName==="help")return i.reply({embeds:[baseEmbed(c,"📚 SHOP MANAGER HELP","**Administration**\n`/setup` — Create starter configuration\n`/verify` — Send verification panel\n`/shop` — Send shop departments\n`/payments` — Send payment methods\n`/offer` — Send a promotional offer\n`/ticket-panel` — Send support panel\n\n**Information**\n`/stats` — View statistics\n`/ping` — View latency\n\nAll management features are also available from the web dashboard.")],ephemeral:true});
 if(i.commandName==="setup"){if(!c.categories.length)c.categories.push({id:uid(),name:"Featured Products",emoji:"⭐",description:"Our featured products and current highlights.",footer:"Open a support ticket if you need assistance.",channelId:i.channelId,image:"",enabled:true,products:[]});if(!c.payments.length)c.payments.push({id:uid(),name:"Contact Support",emoji:"💬",description:"Open a support ticket for payment information."});if(!c.verifyChannelId)c.verifyChannelId=i.channelId;if(!c.paymentChannelId)c.paymentChannelId=i.channelId;if(!c.ticketPanelChannelId)c.ticketPanelChannelId=i.channelId;save();log(i.guild.id,"Starter setup completed",i.user);return i.reply({embeds:[baseEmbed(c,"✨ SETUP COMPLETE","Your starter shop configuration has been created.\n\nUse the web dashboard to add products, configure roles/channels and customize every panel.")],ephemeral:true});}
 if(i.commandName==="verify"){const ch=client.channels.cache.get(c.verifyChannelId)||i.channel;await ch.send(verifyPanel(c));log(i.guild.id,"Verification panel sent",i.user);return i.reply({content:`✅ Verification panel sent to <#${ch.id}>.`,ephemeral:true});}
 if(i.commandName==="shop"){let n=0;for(const cat of c.categories.filter(x=>x.enabled!==false)){const ch=client.channels.cache.get(cat.channelId)||i.channel;if(ch?.isTextBased()){await ch.send({embeds:[categoryEmbed(c,cat)]});n++;}}log(i.guild.id,"Shop panels sent",i.user,{count:n});return i.reply({content:`✅ Sent **${n}** shop department panel(s).`,ephemeral:true});}
 if(i.commandName==="payments"){const ch=client.channels.cache.get(c.paymentChannelId)||i.channel;await ch.send({embeds:[paymentsEmbed(c)]});log(i.guild.id,"Payment panel sent",i.user);return i.reply({content:`✅ Payment panel sent to <#${ch.id}>.`,ephemeral:true});}
 if(i.commandName==="offer"){const name=i.options.getString("name"),price=i.options.getString("price"),description=i.options.getString("description")||"Limited-time promotion. Contact support for details.";const e=baseEmbed(c,`🔥 ${name}`,`**LIMITED-TIME OFFER**\n\n${description}\n\n💰 **Special Price:** ${price}\n\n🎫 Open a support ticket to place an order or ask a question.`).setThumbnail(client.user.displayAvatarURL());await i.channel.send({embeds:[e]});c.offers.unshift({id:uid(),name,price,description,createdAt:Date.now()});log(i.guild.id,"Offer sent",i.user,{name});return i.reply({content:"✅ Offer posted.",ephemeral:true});}
 if(i.commandName==="ticket-panel"){const ch=client.channels.cache.get(c.ticketPanelChannelId)||i.channel;await ch.send(ticketPanel(c));log(i.guild.id,"Ticket panel sent",i.user);return i.reply({content:`✅ Support panel sent to <#${ch.id}>.`,ephemeral:true});}
 if(i.commandName==="stats"){const products=c.categories.reduce((n,x)=>n+x.products.length,0),open=c.tickets.filter(x=>!x.closedAt).length;return i.reply({embeds:[baseEmbed(c,"📊 SHOP STATISTICS","Here is your current shop overview.").addFields({name:"📁 Departments",value:String(c.categories.length),inline:true},{name:"📦 Products",value:String(products),inline:true},{name:"💳 Payment Methods",value:String(c.payments.length),inline:true},{name:"🔥 Offers",value:String(c.offers.length),inline:true},{name:"🎫 Open Tickets",value:String(open),inline:true},{name:"📝 Activity Logs",value:String(c.logs.length),inline:true})],ephemeral:true});}
 }catch(e){console.error("Interaction error",e);if(!i.replied&&!i.deferred)i.reply({content:"❌ Something went wrong. Please check the server logs.",ephemeral:true}).catch(()=>{});}});

const app=express();app.set("trust proxy",1);app.disable("x-powered-by");app.use(express.urlencoded({extended:true,limit:"100kb"}));app.use(express.json({limit:"100kb"}));app.use(session({secret:process.env.SESSION_SECRET||"invalid-secret",resave:false,saveUninitialized:false,cookie:{httpOnly:true,sameSite:"lax",secure:process.env.COOKIE_SECURE!=="false",maxAge:86400000}}));app.use((req,res,next)=>{res.setHeader("X-Content-Type-Options","nosniff");res.setHeader("X-Frame-Options","DENY");res.setHeader("Referrer-Policy","strict-origin-when-cross-origin");next();});
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function csrf(req){return req.session.csrf||(req.session.csrf=crypto.randomBytes(24).toString("hex"));}
function auth(req,res,next){if(req.session.user)return next();res.redirect("/login");}
function allowed(req,gid){return !!req.session.guilds?.some(g=>g.id===gid);}
function page(title,body){return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title><style>${styles()}</style></head><body><main>${body}</main></body></html>`;}
function styles(){return `*{box-sizing:border-box}body{margin:0;background:#06080d;color:#f5f7ff;font-family:Inter,system-ui,sans-serif;font-size:16px}main{max-width:1450px;margin:auto;padding:30px}.top{display:flex;justify-content:space-between;align-items:center;gap:20px}.brand{font-size:32px;font-weight:900}.muted{color:#9ca8bf}.hero,.card{background:linear-gradient(145deg,#151a27,#0c1018);border:1px solid #293248;border-radius:22px;padding:26px;margin:20px 0;box-shadow:0 18px 60px #0006}.hero h1{font-size:42px;margin:8px 0}.hero p{font-size:18px;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:24px}.stat{background:#090d15;border:1px solid #242d40;border-radius:15px;padding:18px}.stat b{font-size:30px;display:block}.stat span{color:#9ca8bf}.section{font-size:25px;margin:0 0 16px}.row{display:grid;grid-template-columns:90px 1fr 1fr;gap:10px}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}label{display:block;color:#aeb9cf;font-size:14px;margin-top:9px}input,select,textarea{width:100%;padding:13px 14px;border-radius:11px;border:1px solid #30394e;background:#080b12;color:#fff;font-size:15px;margin:7px 0 12px}textarea{min-height:100px}.btn{display:inline-block;border:0;border-radius:11px;background:#5865f2;color:#fff;padding:13px 17px;font-weight:800;cursor:pointer;text-decoration:none}.ghost{background:#20283a}.danger{background:#7d3040}.item{display:flex;justify-content:space-between;align-items:center;gap:12px;background:#0a0f18;border:1px solid #202a3b;border-radius:13px;padding:13px;margin:8px 0}.item small{display:block;color:#9ca8bf;margin-top:5px}.cat{background:#0a0f18;border:1px solid #202a3b;border-radius:16px;padding:18px;margin:12px 0}.cat h3{font-size:22px;margin:0 0 7px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}nav{display:flex;gap:8px;overflow:auto;margin:18px 0}nav a{padding:11px 15px;border-radius:10px;background:#141a27;color:#b8c2d7;text-decoration:none;white-space:nowrap}nav a.active{background:#5865f2;color:#fff}.log{padding:11px 0;border-bottom:1px solid #20283a;display:flex;justify-content:space-between;gap:15px}.login{max-width:650px;margin:100px auto;text-align:center}.login h1{font-size:45px}.center{text-align:center}.small{font-size:13px}@media(max-width:950px){.grid{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){main{padding:15px}.hero h1{font-size:31px}.stats{grid-template-columns:1fr 1fr}.row,.two{grid-template-columns:1fr}.top{align-items:flex-start}.item{align-items:flex-start;flex-direction:column}}`;}

app.get("/health",(req,res)=>res.json({ok:true,discordReady:client.isReady(),uptime:Math.floor(process.uptime()),timestamp:new Date().toISOString()}));
app.get("/",(req,res)=>res.redirect(req.session.user?"/dashboard":"/login"));
app.get("/login",(req,res)=>{if(!process.env.DISCORD_TOKEN||!process.env.CLIENT_ID||!process.env.CLIENT_SECRET||!process.env.REDIRECT_URI||!process.env.SESSION_SECRET)return res.status(500).send(page("Configuration Error",`<div class="card center"><h1>⚠️ Configuration Required</h1><p class="muted">Set DISCORD_TOKEN, CLIENT_ID, CLIENT_SECRET, REDIRECT_URI and SESSION_SECRET in Render.</p></div>`));req.session.oauthState=crypto.randomBytes(24).toString("hex");const p=new URLSearchParams({client_id:process.env.CLIENT_ID,redirect_uri:process.env.REDIRECT_URI,response_type:"code",scope:"identify guilds",state:req.session.oauthState});res.redirect("https://discord.com/oauth2/authorize?"+p);});
app.get("/callback",async(req,res)=>{try{if(!req.query.code||req.query.state!==req.session.oauthState)return res.status(400).send(page("OAuth Error","<div class='card'><h1>❌ OAuth Error</h1><p class='muted'>Invalid login state. Please try again.</p></div>"));const body=new URLSearchParams({client_id:process.env.CLIENT_ID,client_secret:process.env.CLIENT_SECRET,grant_type:"authorization_code",code:req.query.code,redirect_uri:process.env.REDIRECT_URI});const tr=await fetch("https://discord.com/api/oauth2/token",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body});const tok=await tr.json();if(!tok.access_token)return res.status(400).send(page("OAuth Error","<div class='card'><h1>❌ Discord Login Failed</h1></div>"));const h={Authorization:`Bearer ${tok.access_token}`};const ur=await fetch("https://discord.com/api/users/@me",{headers:h});const gr=await fetch("https://discord.com/api/users/@me/guilds",{headers:h});req.session.user=await ur.json();const guilds=await gr.json();req.session.guilds=Array.isArray(guilds)?guilds.filter(g=>(Number(g.permissions)&8)===8):[];req.session.csrf=crypto.randomBytes(24).toString("hex");res.redirect("/dashboard");}catch(e){console.error(e);res.status(500).send(page("OAuth Error","<div class='card'><h1>❌ Login Error</h1></div>"));}});
app.get("/logout",(req,res)=>req.session.destroy(()=>res.redirect("/login")));
app.get("/dashboard",auth,(req,res)=>{const gs=req.session.guilds||[];const gid=req.query.guild||gs[0]?.id;const g=gs.find(x=>x.id===gid);if(!g)return res.send(page("Dashboard","<div class='card'><h1>⚠️ No Managed Servers</h1><p class='muted'>You need Administrator permission on a Discord server.</p></div>"));const c=cfg(gid);const guild=client.guilds.cache.get(gid);const channels=guild?[...guild.channels.cache.values()].filter(x=>[ChannelType.GuildText,ChannelType.GuildCategory].includes(x.type)).map(x=>({id:x.id,name:x.name,type:x.type===ChannelType.GuildCategory?"category":"text"})):[];const roles=guild?[...guild.roles.cache.values()].filter(x=>x.id!==guild.id).map(x=>({id:x.id,name:x.name})):[];const products=c.categories.reduce((n,x)=>n+x.products.length,0);const token=csrf(req);const opt=(arr,sel)=>arr.map(x=>`<option value="${esc(x.id)}" ${x.id===sel?"selected":""}>${esc(x.name)}</option>`).join("");res.send(page("Shop Manager Dashboard",`<div class="top"><div><div class="brand">🛒 ${BOT_NAME}</div><div class="muted">${esc(g.name)} • English Control Center</div></div><a class="btn ghost" href="/logout">Log out</a></div><nav>${gs.map(x=>`<a class="${x.id===gid?"active":""}" href="/dashboard?guild=${x.id}">${esc(x.name)}</a>`).join("")}</nav><div class="hero"><span class="muted">● LIVE SHOP CONTROL</span><h1>${esc(c.shopTitle)}</h1><p>${esc(c.shopDescription)}</p><div class="stats"><div class="stat"><b>${c.categories.length}</b><span>Departments</span></div><div class="stat"><b>${products}</b><span>Products</span></div><div class="stat"><b>${c.payments.length}</b><span>Payment Methods</span></div><div class="stat"><b>${c.tickets.filter(x=>!x.closedAt).length}</b><span>Open Tickets</span></div></div></div><div class="grid"><div class="card"><h2 class="section">🎨 Global Branding</h2><form method="post" action="/settings"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><label>Shop Title</label><input name="shopTitle" value="${esc(c.shopTitle)}"><label>Shop Description</label><textarea name="shopDescription">${esc(c.shopDescription)}</textarea><label>Embed Color</label><input name="brandColor" value="${esc(c.brandColor)}"><button class="btn">Save Branding</button></form></div><div class="card"><h2 class="section">🔐 Verification</h2><form method="post" action="/settings"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><label>Verification Channel</label><select name="verifyChannelId"><option value="">Current channel</option>${opt(channels.filter(x=>x.type==="text"),c.verifyChannelId)}</select><label>Verification Role</label><select name="verifyRoleId"><option value="">Select role</option>${roles.map(x=>`<option value="${x.id}" ${x.id===c.verifyRoleId?"selected":""}>@${esc(x.name)}</option>`).join("")}</select><label>Panel Title</label><input name="verifyTitle" value="${esc(c.verifyTitle)}"><label>Panel Description</label><textarea name="verifyDescription">${esc(c.verifyDescription)}</textarea><button class="btn">Save Verification</button></form><form method="post" action="/post-verify"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><button class="btn ghost">📤 Send Verification Panel</button></form></div><div class="card"><h2 class="section">🎫 Support Tickets</h2><form method="post" action="/settings"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><label>Ticket Category</label><select name="ticketCategoryId"><option value="">No category</option>${opt(channels.filter(x=>x.type==="category"),c.ticketCategoryId)}</select><label>Support Role</label><select name="ticketSupportRoleId"><option value="">No support role</option>${roles.map(x=>`<option value="${x.id}" ${x.id===c.ticketSupportRoleId?"selected":""}>@${esc(x.name)}</option>`).join("")}</select><label>Panel Channel</label><select name="ticketPanelChannelId"><option value="">Current channel</option>${opt(channels.filter(x=>x.type==="text"),c.ticketPanelChannelId)}</select><label>Panel Title</label><input name="ticketTitle" value="${esc(c.ticketTitle)}"><label>Panel Description</label><textarea name="ticketDescription">${esc(c.ticketDescription)}</textarea><button class="btn">Save Ticket Settings</button></form><form method="post" action="/post-ticket-panel"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><button class="btn ghost">📤 Send Support Panel</button></form></div><div class="card"><h2 class="section">💳 Payments</h2><form method="post" action="/settings"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><label>Payment Channel</label><select name="paymentChannelId"><option value="">Current channel</option>${opt(channels.filter(x=>x.type==="text"),c.paymentChannelId)}</select><button class="btn">Save Channel</button></form>${c.payments.map(p=>`<div class="item"><span>${esc(p.emoji)} <b>${esc(p.name)}</b><small>${esc(p.description)}</small></span><form method="post" action="/payment/delete"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><input type="hidden" name="id" value="${p.id}"><button class="btn danger">Delete</button></form></div>`).join("")}<form method="post" action="/payment"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><div class="row"><input name="emoji" value="💳"><input name="name" placeholder="Payment method" required><input name="description" placeholder="Description"></div><button class="btn">+ Add Method</button></form><form method="post" action="/post-payments"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><button class="btn ghost">📤 Send Payment Panel</button></form></div></div><div class="card"><h2 class="section">📁 Shop Departments</h2>${c.categories.map(cat=>`<div class="cat"><h3>${esc(cat.emoji)} ${esc(cat.name)}</h3><p class="muted">${esc(cat.description)}</p><p class="small">${cat.enabled===false?"⏸ Disabled":"🟢 Enabled"} • ${cat.channelId?`Channel <#${cat.channelId}>`:"No channel selected"}</p>${cat.products.map(p=>`<div class="item"><span>${esc(p.emoji)} <b>${esc(p.name)}</b><small>${esc(p.price)} • ${esc(p.description)}</small></span><form method="post" action="/product/delete"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><input type="hidden" name="categoryId" value="${cat.id}"><input type="hidden" name="productId" value="${p.id}"><button class="btn danger">Delete</button></form></div>`).join("")}<form method="post" action="/product"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><input type="hidden" name="categoryId" value="${cat.id}"><div class="two"><input name="name" placeholder="Product name" required><input name="price" placeholder="Price" required></div><div class="two"><input name="emoji" value="✦"><input name="description" placeholder="Product description"></div><button class="btn">+ Add Product</button></form><div class="actions"><form method="post" action="/post-category"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><input type="hidden" name="categoryId" value="${cat.id}"><button class="btn">📤 Send Department</button></form><form method="post" action="/category/toggle"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><input type="hidden" name="categoryId" value="${cat.id}"><button class="btn ghost">${cat.enabled===false?"▶ Enable":"⏸ Disable"}</button></form><form method="post" action="/category/delete"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><input type="hidden" name="categoryId" value="${cat.id}"><button class="btn danger">Delete Department</button></form></div></div>`).join("")}<form method="post" action="/category"><input type="hidden" name="_csrf" value="${token}"><input type="hidden" name="guild" value="${gid}"><h3>➕ Create Department</h3><div class="row"><input name="emoji" value="📦"><input name="name" placeholder="Department name" required><select name="channelId"><option value="">Select channel</option>${opt(channels.filter(x=>x.type==="text"),"")}</select></div><input name="description" placeholder="Department description"><input name="image" placeholder="Optional image URL"><button class="btn">Create Department</button></form></div><div class="card"><h2 class="section">📝 Recent Activity</h2>${c.logs.slice(0,30).map(l=>`<div class="log"><b>${esc(l.action)}</b><span class="muted">${esc(l.userName)} • ${new Date(l.at).toLocaleString("en-US")}</span></div>`).join("")||"<p class='muted'>No activity yet.</p>"}</div>`);});

function validPost(req,res){if(!req.body._csrf||req.body._csrf!==req.session.csrf){res.status(403).send(page("Security Error","<div class='card'><h1>❌ Request Blocked</h1><p class='muted'>Please reload the dashboard and try again.</p></div>"));return false;}const gid=req.body.guild;if(!gid||!allowed(req,gid)){res.status(403).send("Forbidden");return false;}return true;}
function back(res,gid){res.redirect("/dashboard?guild="+encodeURIComponent(gid));}
app.post("/settings",auth,(req,res)=>{if(!validPost(req,res))return;const c=cfg(req.body.guild);Object.assign(c,{shopTitle:cut(req.body.shopTitle||c.shopTitle,256),shopDescription:cut(req.body.shopDescription||c.shopDescription,4000),brandColor:color(req.body.brandColor),verifyRoleId:req.body.verifyRoleId||null,verifyChannelId:req.body.verifyChannelId||null,verifyTitle:cut(req.body.verifyTitle||c.verifyTitle,256),verifyDescription:cut(req.body.verifyDescription||c.verifyDescription,4000),ticketCategoryId:req.body.ticketCategoryId||null,ticketSupportRoleId:req.body.ticketSupportRoleId||null,ticketPanelChannelId:req.body.ticketPanelChannelId||null,ticketTitle:cut(req.body.ticketTitle||c.ticketTitle,256),ticketDescription:cut(req.body.ticketDescription||c.ticketDescription,4000),paymentChannelId:req.body.paymentChannelId||null});save();log(req.body.guild,"Dashboard settings updated",req.session.user);back(res,req.body.guild);});
app.post("/category",auth,(req,res)=>{if(!validPost(req,res))return;cfg(req.body.guild).categories.push({id:uid(),name:cut(req.body.name,200),emoji:cut(req.body.emoji||"📦",10),description:cut(req.body.description||"",2000),channelId:req.body.channelId||null,image:url(req.body.image),enabled:true,products:[]});save();log(req.body.guild,"Department created",req.session.user,{name:req.body.name});back(res,req.body.guild);});
app.post("/category/toggle",auth,(req,res)=>{if(!validPost(req,res))return;const c=cfg(req.body.guild),x=c.categories.find(x=>x.id===req.body.categoryId);if(x)x.enabled=x.enabled===false;save();back(res,req.body.guild);});
app.post("/category/delete",auth,(req,res)=>{if(!validPost(req,res))return;const c=cfg(req.body.guild);c.categories=c.categories.filter(x=>x.id!==req.body.categoryId);save();log(req.body.guild,"Department deleted",req.session.user);back(res,req.body.guild);});
app.post("/product",auth,(req,res)=>{if(!validPost(req,res))return;const c=cfg(req.body.guild),cat=c.categories.find(x=>x.id===req.body.categoryId);if(!cat)return res.status(404).send("Department not found");cat.products.push({id:uid(),name:cut(req.body.name,200),price:cut(req.body.price,80),description:cut(req.body.description||"",800),emoji:cut(req.body.emoji||"✦",10),enabled:true});save();log(req.body.guild,"Product created",req.session.user,{name:req.body.name});back(res,req.body.guild);});
app.post("/product/delete",auth,(req,res)=>{if(!validPost(req,res))return;const c=cfg(req.body.guild),cat=c.categories.find(x=>x.id===req.body.categoryId);if(cat)cat.products=cat.products.filter(p=>p.id!==req.body.productId);save();back(res,req.body.guild);});
app.post("/payment",auth,(req,res)=>{if(!validPost(req,res))return;cfg(req.body.guild).payments.push({id:uid(),name:cut(req.body.name,200),description:cut(req.body.description||"",800),emoji:cut(req.body.emoji||"💳",10)});save();back(res,req.body.guild);});
app.post("/payment/delete",auth,(req,res)=>{if(!validPost(req,res))return;const c=cfg(req.body.guild);c.payments=c.payments.filter(x=>x.id!==req.body.id);save();back(res,req.body.guild);});
async function channel(id){const c=client.channels.cache.get(id);return c?.isTextBased()?c:null;}
app.post("/post-verify",auth,async(req,res)=>{if(!validPost(req,res))return;const c=cfg(req.body.guild),ch=await channel(c.verifyChannelId);if(!ch)return res.status(400).send("Verification channel is not configured.");await ch.send(verifyPanel(c));log(req.body.guild,"Verification panel sent",req.session.user);back(res,req.body.guild);});
app.post("/post-ticket-panel",auth,async(req,res)=>{if(!validPost(req,res))return;const c=cfg(req.body.guild),ch=await channel(c.ticketPanelChannelId);if(!ch)return res.status(400).send("Ticket panel channel is not configured.");await ch.send(ticketPanel(c));log(req.body.guild,"Ticket panel sent",req.session.user);back(res,req.body.guild);});
app.post("/post-payments",auth,async(req,res)=>{if(!validPost(req,res))return;const c=cfg(req.body.guild),ch=await channel(c.paymentChannelId);if(!ch)return res.status(400).send("Payment channel is not configured.");await ch.send({embeds:[paymentsEmbed(c)]});log(req.body.guild,"Payment panel sent",req.session.user);back(res,req.body.guild);});
app.post("/post-category",auth,async(req,res)=>{if(!validPost(req,res))return;const c=cfg(req.body.guild),cat=c.categories.find(x=>x.id===req.body.categoryId),ch=await channel(cat?.channelId);if(!cat||!ch)return res.status(400).send("Department channel is not configured.");await ch.send({embeds:[categoryEmbed(c,cat)]});log(req.body.guild,"Department panel sent",req.session.user,{name:cat.name});back(res,req.body.guild);});
app.use((req,res)=>res.status(404).send(page("404","<div class='card'><h1>404 — Page Not Found</h1></div>")));
app.use((err,req,res,next)=>{console.error("Web error",err);res.status(500).send(page("Server Error","<div class='card'><h1>⚠️ Server Error</h1><p class='muted'>Check the Render logs for details.</p></div>"));});
app.listen(PORT,()=>console.log(`Web dashboard listening on port ${PORT}`));
