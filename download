fs.mkdirSync(DATA_DIR, { recursive: true });
if (!fs.existsSync(DB_FILE)) fs.writeFileSync(DB_FILE, "{}", "utf8");
let db = {};
try { db = JSON.parse(fs.readFileSync(DB_FILE, "utf8") || "{}"); } catch { db = {}; }
let saveTimer;
function save(){ clearTimeout(saveTimer); saveTimer=setTimeout(()=>fs.writeFileSync(DB_FILE,JSON.stringify(db,null,2)),150); }
function uid(){return crypto.randomUUID();}
function cut(v,n){return String(v??"").slice(0,n);}
function color(v){return /^#[0-9a-f]{6}$/i.test(String(v||""))?v:DEFAULT_COLOR;}
function url(v){try{const x=new URL(String(v));return /^https?:$/.test(x.protocol)?x.toString():"";}catch{return "";}}
function defaults(){return {brandColor:DEFAULT_COLOR,shopTitle:"🛒 PREMIUM SHOP",shopDescription:"Browse our departments and discover everything we currently offer.",verifyTitle:"🔐 VERIFY YOUR ACCOUNT",verifyDescription:"Click the button below to receive access to the server.",ticketTitle:"🎫 CUSTOMER SUPPORT",ticketDescription:"Need help with an order or have a question? Open a private support ticket below.",paymentTitle:"💳 PAYMENT METHODS",paymentDescription:"Choose from the payment methods listed below.",ticketCategoryId:null,ticketSupportRoleId:null,verifyChannelId:null,verifyRoleId:null,paymentChannelId:null,ticketPanelChannelId:null,categories:[],payments:[],offers:[],tickets:[],logs:[]};}
function cfg(gid){if(!db[gid])db[gid]=defaults();const c=db[gid];const d=defaults();for(const [k,v] of Object.entries(d))if(c[k]===undefined)c[k]=Array.isArray(v)?[]:v;if(!Array.isArray(c.categories))c.categories=[];if(!Array.isArray(c.payments))c.payments=[];if(!Array.isArray(c.offers))c.offers=[];if(!Array.isArray(c.tickets))c.tickets=[];if(!Array.isArray(c.logs))c.logs=[];for(const cat of c.categories){if(!Array.isArray(cat.products))cat.products=[];if(cat.enabled===undefined)cat.enabled=true;}return c;}
function log(gid,action,user,extra={}){const c=cfg(gid);c.logs.unshift({id:uid(),action,userId:user?.id||"system",userName:user?.username||"System",at:Date.now(),...extra});c.logs=c.logs.slice(0,300);save();}
function isAdmin(i){return i.memberPermissions?.has(PermissionsBitField.Flags.Administrator);}
function baseEmbed(c,title,description){return new EmbedBuilder().setColor(color(c.brandColor)).setTitle(cut(title,256)).setDescription(cut(description,4096)).setFooter({text:`${BOT_NAME} • Premium Shop System`}).setTimestamp();}
function verifyPanel(c){return {embeds:[baseEmbed(c,c.verifyTitle,c.verifyDescription+"\n\n**Verification gives you access to the server.**\nPlease make sure you have read and accepted the server rules before continuing.")],components:[new ActionRowBuilder().addComponents(new ButtonBuilder().setCustomId("verify").setLabel("VERIFY NOW").setEmoji("✅").setStyle(ButtonStyle.Success))]};}
function ticketPanel(c){return {embeds:[baseEmbed(c,c.ticketTitle,c.ticketDescription+"\n\n**Private • Fast • Staff Assisted**\nClick below and a private support channel will be created for you.")],components:[new ActionRowBuilder().addComponents(new ButtonBuilder().setCustomId("ticket_open").setLabel("OPEN SUPPORT TICKET").setEmoji("🎫").setStyle(ButtonStyle.Primary))]};}
function categoryEmbed(c,cat){const e=baseEmbed(c,`${cat.emoji||"📦"} ${cat.name}`,`${cat.description||"Explore this department below."}\n\n**Available Products**`);for(const p of cat.products.filter(x=>x.enabled!==false).slice(0,25)){e.addFields({name:`${p.emoji||"✦"} ${p.name} — ${p.price}`,value:`${p.description||"No description available."}\n\u200b`,inline:false});}if(!cat.products.length)e.addFields({name:"Coming Soon",value:"This department currently has no products listed.",inline:false});const im=url(cat.image);if(im)e.setImage(im);return e;}
function paymentsEmbed(c){const e=baseEmbed(c,c.paymentTitle,c.paymentDescription+"\n\n**Available Methods**");for(const p of c.payments.slice(0,25))e.addFields({name:`${p.emoji||"💳"} ${p.name}`,value:`${p.description||"Available on request."}\n\u200b`,inline:false});if(!c.payments.length)e.addFields({name:"No methods configured",value:"Please contact support for payment information.",inline:false});return e;}

const commands=[
 new SlashCommandBuilder().setName("setup").setDescription("Create a starter shop configuration."),
 new SlashCommandBuilder().setName("verify").setDescription("Send the verification panel."),
 new SlashCommandBuilder().setName("shop").setDescription("Send all enabled shop departments."),
 new SlashCommandBuilder().setName("payments").setDescription("Send the payment methods panel."),
 new SlashCommandBuilder().setName("offer").setDescription("Send a large promotional offer.").addStringOption(o=>o.setName("name").setDescription("Offer name").setRequired(true)).addStringOption(o=>o.setName("price").setDescription("Offer price").setRequired(true)).addStringOption(o=>o.setName("description").setDescription("Offer description").setRequired(false)),
