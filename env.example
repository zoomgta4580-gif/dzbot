# ==============================
# REQUIRED RENDER VARIABLES
# ==============================
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
CLIENT_SECRET=YOUR_DISCORD_OAUTH_CLIENT_SECRET
REDIRECT_URI=https://YOUR-SERVICE.onrender.com/callback
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# ==============================
# RECOMMENDED RENDER VARIABLES
# ==============================
NODE_ENV=production
PORT=10000
COOKIE_SECURE=true
DATA_DIR=/var/data
BOT_STATUS=Shop Manager | /help

# ==============================
# OPTIONAL BRANDING
# ==============================
BOT_NAME=Shop Manager
DEFAULT_COLOR=#5865F2
