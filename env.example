# REQUIRED
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id
CLIENT_SECRET=your_discord_oauth_client_secret
REDIRECT_URI=https://YOUR-SERVICE.onrender.com/callback
SESSION_SECRET=generate-a-long-random-secret

# RENDER / STORAGE
NODE_ENV=production
PORT=10000
COOKIE_SECURE=true
DATA_DIR=/var/data

# OPTIONAL BRANDING
BOT_NAME=DZSERVICE
BOT_STATUS=Premium Shop • /shop
DEFAULT_COLOR=#5865F2
